Makefile: "$(file >out.txt,line one)\n$(file >>out.txt,line two)\n$(file >empty.txt)\nX := $(file <out.txt)\nall: ; @echo \"[$(X)]\" \"[$(file <nope)]\"\n"
empty.txt: ""
out.txt: "line one\nline two\n"
