=== files
Makefile: "A = x\nifeq ($(A),x)\n$(info paren yes)\nendif\nifeq \"$(A)\" \"x\"\n$(info double yes)\nendif\nifeq '$(A)' 'x'\n$(info single yes)\nendif\nifeq \"$(A)\" 'x'\n$(info mixed yes)\nendif\nifneq ($(A),y)\n$(info ifneq yes)\nendif\nifeq (,$(B))\n$(info empty yes)\nendif\nifeq ($(A), x)\n$(info space after comma yes)\nendif\nall: ;\n"
