##### include
=== make
--- status 0
--- stdout
from-a from-b
--- stderr

=== files
Makefile: "include a.mk b.mk\nall: ; @echo $(A) $(B)\n"
a.mk: "A = from-a\n"
b.mk: "B = from-b\n"
##### include-glob
=== make
--- status 0
--- stdout
one two
--- stderr

=== files
Makefile: "include parts/*.mk\nall: ; @echo $(sort $(PARTS))\n"
parts/
parts/one.mk: "PARTS += one\n"
parts/two.mk: "PARTS += two\n"
