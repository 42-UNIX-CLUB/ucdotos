gen.mk: "V = generated\n"
##### include-out-of-date
=== touch -d '2001-01-01' dep.mk
--- status 0
--- stdout
--- stderr

=== echo new > dep.src
--- status 0
--- stdout
--- stderr

=== make
--- status 0
--- stdout
regen
V=new
--- stderr

=== make
--- status 0
--- stdout
V=new
--- stderr

=== files
Makefile: "include dep.mk\nall: ; @echo \"V=$(V)\"\ndep.mk: dep.src ; @echo regen; sed 's/^/V = /' dep.src > dep.mk\n"
dep.mk: "V = new\n"
dep.src: "new\n"
