=== files
Makefile: "OBJS = a.o\nall: $(OBJS) ; @echo all done\n%.o: %.c ; @echo compile $<; echo '$@: $< $(basename $<).h' > $(basename $@).d; touch $@\n-include $(OBJS:.o=.d)\n"
a.c: "\n"
a.d: "a.o: a.c a.h\n"
a.h: "\n"
a.o: ""
