##### include-makefile-list-last
=== make
--- status 0
--- stdout
sub/
--- stderr

=== files
Makefile: "include sub/inc.mk\nall: ; @echo $(HERE)\n"
sub/
sub/inc.mk: "HERE := $(dir $(lastword $(MAKEFILE_LIST)))\n"
