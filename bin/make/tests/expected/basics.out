##### dash-f
=== make -f one.mk
--- status 0
--- stdout
a
--- stderr

=== make -f one.mk -f two.mk a b
--- status 0
--- stdout
a from-two
b
--- stderr

=== make --file=two.mk
--- status 0
--- stdout
b
--- stderr

=== make --makefile two.mk
--- status 0
--- stdout
b
--- stderr

=== files
one.mk: "a: ; @echo a $(V)\n"
two.mk: "V = from-two\nb: ; @echo b\n"
