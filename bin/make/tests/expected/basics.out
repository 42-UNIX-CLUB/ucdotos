##### simple
=== make
--- status 0
--- stdout
echo hello
hello
--- stderr

=== make all
--- status 0
--- stdout
echo hello
hello
--- stderr

=== files
Makefile: "all:\n\techo hello\n"
##### default-goal-first
=== make
--- status 0
--- stdout
first
--- stderr

=== make second first
--- status 0
--- stdout
second
first
--- stderr

=== files
Makefile: "first: ; @echo first\nsecond: ; @echo second\n"
##### default-goal-skips-dot
=== make
--- status 0
--- stdout
dirdot
--- stderr

=== files
Makefile: ".hidden: ; @echo hidden\n%.x: ; @echo pattern\ndir/.ok: ; @echo dirdot\nreal: ; @echo real\n"
##### default-goal-var
=== make
--- status 0
--- stdout
two
--- stderr

=== files
Makefile: ".DEFAULT_GOAL := two\none: ; @echo one\ntwo: ; @echo two\n"
##### default-goal-reset
=== make
--- status 0
--- stdout
goal=one
two
--- stderr

=== files
Makefile: "one: ; @echo one\n$(info goal=$(.DEFAULT_GOAL))\n.DEFAULT_GOAL :=\ntwo: ; @echo two\n"
##### up-to-date
=== make
--- status 0
--- stdout
cp in out
--- stderr

=== make
--- status 0
--- stdout
make: Nothing to be done for 'all'.
--- stderr

=== make out
--- status 0
--- stdout
make: 'out' is up to date.
--- stderr

=== make all
--- status 0
--- stdout
make: Nothing to be done for 'all'.
--- stderr

=== files
Makefile: "all: out\nout: in\n\tcp in out\n"
in: "data\n"
out: "data\n"
##### nothing-to-be-done
=== make
--- status 0
--- stdout
make: Nothing to be done for 'all'.
--- stderr

=== make in
--- status 0
--- stdout
make: Nothing to be done for 'in'.
--- stderr

=== files
Makefile: "all: in\n"
in: "x\n"
##### multiple-targets
=== make a b c
--- status 0
--- stdout
making a
making b
making c
--- stderr

=== make b
--- status 0
--- stdout
making b
--- stderr

=== files
Makefile: "a b c:\n\t@echo making $@\n"
##### line-continuation
=== make
--- status 0
--- stdout
one two three
a b
x \
y
--- stderr

=== files
Makefile: "X = one \\\n    two \\\n\tthree\nall:\n\t@echo $(X)\n\t@echo a \\\n\tb\n\t@echo 'x \\\n\ty'\n"
##### comments
=== make
--- status 0
--- stdout
[value ] [with#hash] [#bc]
# this goes to the shell
--- stderr

=== files
Makefile: "# a comment\nX = value # trailing comment\nY = with\\#hash\nZ = $(subst a,#,abc)\nall: # comment after the colon\n\t@echo \"[$(X)]\" \"[$(Y)]\" \"[$(Z)]\"\n\t# this goes to the shell\n\t@# and this too\n"
##### semicolon-recipe
=== make
--- status 0
--- stdout
dep
all dep
--- stderr

=== files
Makefile: "all: dep ; @echo all $<\ndep: ; @echo dep\n"
##### recipe-prefix
=== make
--- status 0
--- stdout
with prefix
second line
--- stderr

=== files
Makefile: ".RECIPEPREFIX = >\nall:\n> @echo with prefix\n> @echo second line\n"
