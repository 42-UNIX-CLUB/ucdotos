@ test-one-arg
[ x ]; echo $?; [ "" ]; echo $?
@ test-no-args
[ ]; echo $?
@ test-num
[ 1 -eq 1 ]; echo $?; [ 1 -ne 1 ]; echo $?; [ 1 -lt 2 ]; echo $?; [ 2 -le 1 ]; echo $?; [ 3 -gt 2 ]; echo $?; [ 3 -ge 4 ]; echo $?
