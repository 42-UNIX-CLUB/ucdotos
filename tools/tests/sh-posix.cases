trap 'echo once' EXIT; exit 0
@ trap-exit-in-subshell-only
(trap 'echo sub' EXIT); echo main
@ trap-exit-subst
x=$(trap 'echo in-trap' EXIT; echo body); echo "$x"
@ trap-kill-self-term
trap 'echo got-term' TERM; kill -TERM $$; echo after
@why needs signal delivery (fork stream); recorded but not fired on a system without signals
@out got-term
@out after
@ trap-exit-after-error
trap 'echo trapped' EXIT; nosuch_cmd_t 2>/dev/null
@ unset-var
x=1; unset x; echo "[${x-unset}]"
@ unset-v
x=1; unset -v x; echo "[${x-unset}]"
@ unset-f
f() { :; }; unset -f f; type f >/dev/null 2>&1 || echo gone
@ unset-multiple
a=1 b=2; unset a b; echo "[$a$b]"
@ unset-nonexistent
unset nothing_here; echo $?
@ unset-exported
export UE=1; unset UE; sh -c 'echo "[$UE]"'
@ unset-positional-param
x=1; unset x; echo ${x:-gone}

# ---------------------------------------------------------------- regular builtins
@ cd-basic
cd /; pwd
@ cd-home
HOME=/tmp; cd; pwd
@ cd-dash
cd /; cd /tmp; cd - >/dev/null; pwd
@ cd-dash-prints
cd /; cd /tmp; cd -
@ cd-oldpwd
cd /; cd /tmp; echo $OLDPWD
@ cd-pwd-var
cd /tmp; echo $PWD
@ cd-fail
cd /nonexistent_dir 2>/dev/null; echo $?
@ cd-relative
mkdir -p cdr/sub; cd cdr; cd sub; basename_dir=${PWD##*/}; echo $basename_dir
@ cd-dotdot
mkdir -p cdd/s; cd cdd/s; cd ..; echo ${PWD##*/}
@ cd-P
cd -P / && pwd
@ cd-L
cd -L / && pwd
@ cd-cdpath
mkdir -p cdp/target; CDPATH=$PWD/cdp; cd target >/dev/null; echo ${PWD##*/}
@ cd-file
touch cdf.f; cd cdf.f 2>/dev/null; echo $?
@ pwd-basic
cd /tmp; pwd
@ pwd-P
cd /tmp; pwd -P
@ pwd-L
cd /tmp; pwd -L
@ command-v-builtin
command -v cd
@ command-v-external
command -v sh >/dev/null && echo found
@ command-v-function
f() { :; }; command -v f
