@ true-status
true; echo $?
@ getopts-basic
set -- -a -b arg file; while getopts ab: o; do echo "$o:${OPTARG-}"; done; shift $((OPTIND-1)); echo "rest=$*"
@ getopts-combined
set -- -ab -c x; while getopts abc: o; do echo "$o${OPTARG:+=$OPTARG}"; done
@ getopts-attached-arg
set -- -cvalue; while getopts c: o; do echo "$o=$OPTARG"; done
@ getopts-unknown
set -- -z; getopts ab o 2>/dev/null; echo "$o $?"
@ getopts-unknown-silent
set -- -z; getopts :ab o; echo "$o $OPTARG"
@ getopts-missing-arg
set -- -b; getopts :b: o; echo "$o $OPTARG"
@ getopts-missing-arg-loud
set -- -b; getopts b: o 2>/dev/null; echo "$o"
@ getopts-end
set -- file; getopts a o; echo "$? $o $OPTIND"
@ getopts-dashdash
set -- -a -- -b; while getopts ab o; do echo $o; done; echo $OPTIND
@ getopts-explicit-args
getopts x: o -x val; echo "$o $OPTARG"
@ getopts-optind-reset
