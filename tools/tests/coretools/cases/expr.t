# expr (integers are 64-bit here; GNU expr uses arbitrary precision, so results
# beyond 64 bits are an error instead of a big number: not tested)
%setup
%cases
expr 1 + 2; echo "st=$?"
expr 10 - 20; echo "st=$?"
expr 6 \* 7; echo "st=$?"
expr 7 / 2; echo "st=$?"
expr -7 / 2; echo "st=$?"
expr 7 % 3; echo "st=$?"
expr -7 % 3; echo "st=$?"
expr 1 + 2 \* 3; echo "st=$?"
expr \( 1 + 2 \) \* 3; echo "st=$?"
expr 2 - 2; echo "st=$?"
expr 5 / 0; echo "st=$?"
expr 5 % 0; echo "st=$?"
expr a + 1; echo "st=$?"
expr 1 +; echo "st=$?"
expr; echo "st=$?"
expr 9223372036854775807 + 0; echo "st=$?"
expr 3000000000 \* 3000000000; echo "st=$?"
expr 1 = 1; echo "st=$?"
expr 1 = 01; echo "st=$?"
expr a = a; echo "st=$?"
expr a != b; echo "st=$?"
expr 10 \> 9; echo "st=$?"
expr 10 \< 9; echo "st=$?"
expr a \< b; echo "st=$?"
expr abc \> abd; echo "st=$?"
expr 10 \>= 10; echo "st=$?"
expr 10 \<= 9; echo "st=$?"
expr 10 \> 9a; echo "st=$?"
expr 2 == 2; echo "st=$?"
expr 0 \| 3; echo "st=$?"
expr 4 \| 3; echo "st=$?"
expr '' \| ''; echo "st=$?"
expr '' \| 0; echo "st=$?"
expr 0 \& 3; echo "st=$?"
expr 2 \& 3; echo "st=$?"
expr 2 \& ''; echo "st=$?"
expr abc : 'a.c'; echo "st=$?"
expr abc : 'b'; echo "st=$?"
expr abcdef : 'a\(.*\)e'; echo "st=$?"
expr abc : 'x\(.*\)'; echo "st=$?"
expr abc : '.*'; echo "st=$?"
expr '' : '.*'; echo "st=$?"
expr foo.c : '\(.*\)\.c'; echo "st=$?"
expr foo.h : '\(.*\)\.c'; echo "st=$?"
expr 12345 : '[0-9]*$'; echo "st=$?"
expr 123a5 : '[0-9]*$'; echo "st=$?"
expr aaa : 'a\{2\}'; echo "st=$?"
expr abc : 'a\(b\)\(c\)'; echo "st=$?"
expr abc : '\(x\)*'; echo "st=$?"
expr abc : '('; echo "st=$?"
expr abc : '\('; echo "st=$?"
expr match abcd 'ab'; echo "st=$?"
expr match abcd '\(bc\)'; echo "st=$?"
expr length abcdef; echo "st=$?"
expr length ''; echo "st=$?"
expr substr abcdef 2 3; echo "st=$?"
expr substr abcdef 5 10; echo "st=$?"
expr substr abcdef 0 2; echo "st=$?"
expr substr abcdef 7 1; echo "st=$?"
expr substr abcdef 2 -1; echo "st=$?"
expr index abcdef cd; echo "st=$?"
expr index abcdef xyz; echo "st=$?"
expr index abcdef fa; echo "st=$?"
expr + length; echo "st=$?"
expr + 5 + 1; echo "st=$?"
expr length + match; echo "st=$?"
expr -- 3 + 4; echo "st=$?"
expr \( 1 + 2; echo "st=$?"
expr 1 + 2 \); echo "st=$?"
expr 1 2; echo "st=$?"
expr \(; echo "st=$?"
expr hello; echo "st=$?"
expr 0; echo "st=$?"
expr -0; echo "st=$?"
expr 00; echo "st=$?"
expr ''; echo "st=$?"
expr -5; echo "st=$?"
expr ' 5' + 1; echo "st=$?"
expr +5 + 1; echo "st=$?"
expr 1 + 2 + 3 - 4 \* 5 / 2 % 3; echo "st=$?"
expr \( \( 2 \) \); echo "st=$?"
expr 3 \> 2 \& 1 \< 2; echo "st=$?"
expr a \| b \& c; echo "st=$?"
x=5; x=$(expr $x + 1); echo $x
i=0; while [ $i -lt 5 ]; do i=$(expr $i + 1); done; echo $i
