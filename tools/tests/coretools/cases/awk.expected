{"cmd":"awk '{ print }' people","out":"alice 30 paris\nbob 25 london\ncarol 35 paris\ndave 40 berlin\neve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ print $1 }' people","out":"alice\nbob\ncarol\ndave\neve\n","status":0,"err":false}
{"cmd":"awk '{ print $NF }' people","out":"paris\nlondon\nparis\nberlin\nlondon\n","status":0,"err":false}
{"cmd":"awk '{ print $(NF-1) }' people","out":"30\n25\n35\n40\n22\n","status":0,"err":false}
{"cmd":"awk '{ print NR, NF, $0 }' people","out":"1 3 alice 30 paris\n2 3 bob 25 london\n3 3 carol 35 paris\n4 3 dave 40 berlin\n5 3 eve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ print $1, $3 }' people","out":"alice paris\nbob london\ncarol paris\ndave berlin\neve london\n","status":0,"err":false}
{"cmd":"awk '{ print $1 $3 }' people","out":"aliceparis\nboblondon\ncarolparis\ndaveberlin\nevelondon\n","status":0,"err":false}
{"cmd":"awk '{ print length() }' people","out":"14\n13\n14\n14\n13\n","status":0,"err":false}
{"cmd":"awk '{ print length }' people","out":"14\n13\n14\n14\n13\n","status":0,"err":false}
{"cmd":"awk '{ print length($1) }' people","out":"5\n3\n5\n4\n3\n","status":0,"err":false}
{"cmd":"awk 'NR == 2' people","out":"bob 25 london\n","status":0,"err":false}
{"cmd":"awk 'NR % 2' people","out":"alice 30 paris\ncarol 35 paris\neve 22 london\n","status":0,"err":false}
{"cmd":"awk 'NR > 1 && NR < 4' people","out":"bob 25 london\ncarol 35 paris\n","status":0,"err":false}
{"cmd":"awk '$2 > 30' people","out":"carol 35 paris\ndave 40 berlin\n","status":0,"err":false}
{"cmd":"awk '$2 >= 30 { print $1 }' people","out":"alice\ncarol\ndave\n","status":0,"err":false}
{"cmd":"awk '$3 == \"paris\"' people","out":"alice 30 paris\ncarol 35 paris\n","status":0,"err":false}
{"cmd":"awk '$3 ~ /lon/' people","out":"bob 25 london\neve 22 london\n","status":0,"err":false}
{"cmd":"awk '$3 !~ /lon/' people","out":"alice 30 paris\ncarol 35 paris\ndave 40 berlin\n","status":0,"err":false}
{"cmd":"awk '/^[ab]/' people","out":"alice 30 paris\nbob 25 london\n","status":0,"err":false}
{"cmd":"awk '!/a/' people","out":"bob 25 london\neve 22 london\n","status":0,"err":false}
{"cmd":"awk '/bob/, /dave/' people","out":"bob 25 london\ncarol 35 paris\ndave 40 berlin\n","status":0,"err":false}
{"cmd":"awk 'NR == 2, NR == 3 { print NR }' people","out":"2\n3\n","status":0,"err":false}
{"cmd":"awk '/eve/, /never/' people","out":"eve 22 london\n","status":0,"err":false}
{"cmd":"awk 'END { print NR }' people","out":"5\n","status":0,"err":false}
{"cmd":"awk 'END { print $0 }' people","out":"eve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ s += $2 } END { print s, s / NR }' people","out":"152 30.4\n","status":0,"err":false}
{"cmd":"awk '{ a[$3]++ } END { for (k in a) n++; print n }' people","out":"3\n","status":0,"err":false}
{"cmd":"awk '{ a[$3] += $2 } END { print a[\"paris\"], a[\"london\"], a[\"berlin\"] }' people","out":"65 47 40\n","status":0,"err":false}
{"cmd":"awk '{ if ($2 > max) { max = $2; who = $1 } } END { print who, max }' people","out":"dave 40\n","status":0,"err":false}
{"cmd":"awk '{ $2 = $2 + 1; print }' people","out":"alice 31 paris\nbob 26 london\ncarol 36 paris\ndave 41 berlin\neve 23 london\n","status":0,"err":false}
{"cmd":"awk '{ $5 = \"X\"; print; print NF }' people","out":"alice 30 paris  X\n5\nbob 25 london  X\n5\ncarol 35 paris  X\n5\ndave 40 berlin  X\n5\neve 22 london  X\n5\n","status":0,"err":false}
{"cmd":"awk '{ NF = 2; print }' people","out":"alice 30\nbob 25\ncarol 35\ndave 40\neve 22\n","status":0,"err":false}
{"cmd":"awk '{ $0 = toupper($0); print $1 }' people","out":"ALICE\nBOB\nCAROL\nDAVE\nEVE\n","status":0,"err":false}
{"cmd":"awk '{ $1 = \"\"; print }' people","out":" 30 paris\n 25 london\n 35 paris\n 40 berlin\n 22 london\n","status":0,"err":false}
{"cmd":"awk '{ printf \"%-6s|%3d|\\n\", $1, $2 }' people","out":"alice | 30|\nbob   | 25|\ncarol | 35|\ndave  | 40|\neve   | 22|\n","status":0,"err":false}
{"cmd":"awk '{ printf \"%s\\n\", $0 > \"out\" } END { close(\"out\"); while ((getline l < \"out\") > 0) print \"re:\", l }' people","out":"re: alice 30 paris\nre: bob 25 london\nre: carol 35 paris\nre: dave 40 berlin\nre: eve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ print > \"o1\"; print $1 >> \"o2\" } END { close(\"o1\"); close(\"o2\"); system(\"cat o1 o2\") }' people","out":"alice 30 paris\nbob 25 london\ncarol 35 paris\ndave 40 berlin\neve 22 london\nalice\nbob\ncarol\ndave\neve\n","status":0,"err":false}
{"cmd":"awk '{ print | \"sort -r\" }' people","out":"eve 22 london\ndave 40 berlin\ncarol 35 paris\nbob 25 london\nalice 30 paris\n","status":0,"err":false}
{"cmd":"awk '{ print $1 | \"sort\" } END { close(\"sort\"); print \"done\" }' people","out":"alice\nbob\ncarol\ndave\neve\ndone\n","status":0,"err":false}
{"cmd":"awk 'BEGIN { OFS = \"-\" } { $1 = $1; print }' people","out":"alice-30-paris\nbob-25-london\ncarol-35-paris\ndave-40-berlin\neve-22-london\n","status":0,"err":false}
{"cmd":"awk 'BEGIN { OFS = \"-\" } { print $1, $2 }' people","out":"alice-30\nbob-25\ncarol-35\ndave-40\neve-22\n","status":0,"err":false}
{"cmd":"awk 'BEGIN { ORS = \";\" } { print $1 } END { printf \"\\n\" }' people","out":"alice;bob;carol;dave;eve;\n","status":0,"err":false}
{"cmd":"awk 'BEGIN { FS = \"a\" } { print $1 }' people","out":"\nbob 25 london\nc\nd\neve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ n = split($0, w); print n, w[n] }' people","out":"3 paris\n3 london\n3 paris\n3 berlin\n3 london\n","status":0,"err":false}
{"cmd":"awk '{ gsub(/[aeiou]/, \"_\"); print }' people","out":"_l_c_ 30 p_r_s\nb_b 25 l_nd_n\nc_r_l 35 p_r_s\nd_v_ 40 b_rl_n\n_v_ 22 l_nd_n\n","status":0,"err":false}
{"cmd":"awk '{ sub(/a/, \"A\"); print }' people","out":"Alice 30 paris\nbob 25 london\ncArol 35 paris\ndAve 40 berlin\neve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ n = gsub(/a/, \"&&\"); print n, $0 }' people","out":"2 aalice 30 paaris\n0 bob 25 london\n2 caarol 35 paaris\n1 daave 40 berlin\n0 eve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ gsub(/a/, \"\\\\&\"); print }' people","out":"&lice 30 p&ris\nbob 25 london\nc&rol 35 p&ris\nd&ve 40 berlin\neve 22 london\n","status":0,"err":false}
{"cmd":"awk '{ print match($0, /[0-9]+/), RSTART, RLENGTH }' people","out":"7 7 2\n5 5 2\n7 7 2\n6 6 2\n5 5 2\n","status":0,"err":false}
{"cmd":"awk '{ print index($0, \"o\") }' people","out":"0\n2\n4\n0\n9\n","status":0,"err":false}
{"cmd":"awk '{ print substr($0, 3) }' people","out":"ice 30 paris\nb 25 london\nrol 35 paris\nve 40 berlin\ne 22 london\n","status":0,"err":false}
{"cmd":"awk '{ print substr($1, 2, 2) }' people","out":"li\nob\nar\nav\nve\n","status":0,"err":false}
{"cmd":"awk '{ print toupper(substr($1,1,1)) substr($1,2) }' people","out":"Alice\nBob\nCarol\nDave\nEve\n","status":0,"err":false}
{"cmd":"awk '{ print NR \": \" $0 }' people","out":"1: alice 30 paris\n2: bob 25 london\n3: carol 35 paris\n4: dave 40 berlin\n5: eve 22 london\n","status":0,"err":false}
{"cmd":"awk 'NR == 1 { next } { print }' people","out":"bob 25 london\ncarol 35 paris\ndave 40 berlin\neve 22 london\n","status":0,"err":false}
{"cmd":"awk 'NR == 3 { exit } { print }' people","out":"alice 30 paris\nbob 25 london\n","status":0,"err":false}
{"cmd":"awk 'END { exit 3 }' people","out":"","status":3,"err":false}
{"cmd":"awk '{ $3 = \"\"; print NF }' people","out":"3\n3\n3\n3\n3\n","status":0,"err":false}
{"cmd":"awk '{ print ($2 > 28 ? \"old\" : \"young\") }' people","out":"old\nyoung\nold\nold\nyoung\n","status":0,"err":false}
{"cmd":"awk '{ c = c $1 } END { print c }' people","out":"alicebobcaroldaveeve\n","status":0,"err":false}
{"cmd":"awk '{ print $2 * 2, $2 / 3, $2 % 7, $2 ^ 2, -$2 }' people","out":"60 10 2 900 -30\n50 8.33333 4 625 -25\n70 11.6667 0 1225 -35\n80 13.3333 5 1600 -40\n44 7.33333 1 484 -22\n","status":0,"err":false}
{"cmd":"awk '{ x[NR] = $1 } END { for (i = NR; i > 0; i--) print x[i] }' people","out":"eve\ndave\ncarol\nbob\nalice\n","status":0,"err":false}
{"cmd":"awk '{ print $1 > \"/dev/stderr\" }' people","out":"","status":0,"err":true}
{"cmd":"awk -F, '{ print $2 }' csv","out":"b\n2\nx\n","status":0,"err":false}
{"cmd":"awk -F, '{ print NF }' csv","out":"3\n3\n3\n","status":0,"err":false}
{"cmd":"awk -F, -v OFS=';' '{ $1 = $1; print }' csv","out":"a;b;c\n1;2;3\n;x;\n","status":0,"err":false}
