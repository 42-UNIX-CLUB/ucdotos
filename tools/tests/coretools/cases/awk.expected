{"cmd":"awk -Ft '{ print $3 }' tsv","out":"\n\n","status":0,"err":false}
{"cmd":"awk -F: '{ print $1 }' conf","out":"key=value\n# comment\nname = test\n\nempty=\n","status":0,"err":false}
