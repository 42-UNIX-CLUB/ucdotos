# kanagawa: Kanagawa. Inspired by Hokusai's Great Wave: ink blues, old paper and autumn reds.
#
# One of the example themes that ship with UC.OS. Pick it with the theme picker
# ($mod SHIFT t), cycle with $mod t, or write its name into ~/.config/ucos/theme.
# Copy it under a new name to make your own. The format is .uconf: see deck.uconf.

[theme]
description = kanagawa wave

[colors]
bg      = #1f1f28
fg      = #dcd7ba
accent  = #7e9cd8
dim     = #727169
desktop = #16161d
panel   = #2a2a37
surface = #363646
bar {
    bg = #16161d
    fg = #dcd7ba
}
border {
    focus  = #7e9cd8
    normal = #54546d
    float  = #e6c384
}

[terminal]
black   = #16161d
red     = #c34043
green   = #76946a
yellow  = #c0a36e
blue    = #7e9cd8
magenta = #957fb8
cyan    = #6a9589
white   = #c8c093
bright {
    black   = #727169
    red     = #e82424
    green   = #98bb6c
    yellow  = #e6c384
    blue    = #7fb4ca
    magenta = #938aa9
    cyan    = #7aa89f
    white   = #dcd7ba
}

[font]
name    = JetBrains Mono
regular = JetBrainsMonoNerdFontMono-Regular.ttf
bold    = JetBrainsMonoNerdFontMono-Bold.ttf
size    = 15

[geometry]
gap    = 12
border = 2
radius = 6
