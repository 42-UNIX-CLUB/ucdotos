# everforest: Everforest. Calm forest greens and warm earth tones, easy on the eyes.
#
# One of the example themes that ship with UC.OS. Pick it with the theme picker
# ($mod SHIFT t), cycle with $mod t, or write its name into ~/.config/ucos/theme.
# Copy it under a new name to make your own. The format is .uconf: see deck.uconf.

[theme]
description = everforest dark

[colors]
bg      = #2d353b
fg      = #d3c6aa
accent  = #a7c080
dim     = #859289
desktop = #232a2e
panel   = #343f44
surface = #3d484d
bar {
    bg = #343f44
    fg = #d3c6aa
}
border {
    focus  = #a7c080
    normal = #475258
    float  = #dbbc7f
}

[terminal]
black   = #475258
red     = #e67e80
green   = #a7c080
yellow  = #dbbc7f
blue    = #7fbbb3
magenta = #d699b6
cyan    = #83c092
white   = #d3c6aa
bright {
    black   = #7a8478
    red     = #e67e80
    green   = #a7c080
    yellow  = #dbbc7f
    blue    = #7fbbb3
    magenta = #d699b6
    cyan    = #83c092
    white   = #d3c6aa
}

[font]
name    = JetBrains Mono
regular = JetBrainsMonoNerdFontMono-Regular.ttf
bold    = JetBrainsMonoNerdFontMono-Bold.ttf
size    = 15

[geometry]
gap    = 14
border = 2
radius = 10
